# Configuration email — copier ce fichier en .env et remplir les valeurs réelles
# IMPORTANT: Utiliser un MOT DE PASSE D'APPLICATION Gmail (pas le mot de passe principal)
# Comment créer un mot de passe d'application:
# 1. myaccount.google.com → Sécurité → Mots de passe des applications
# 2. Générer un nouveau mot de passe pour "HRM System"
# 3. Copiez le mot de passe généré ici

EMAIL_HOST_USER=votre.email@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# Clé secrète Django — générer avec: python -c "from django.core.utils.crypto import get_random_string; print(get_random_string(50))"
SECRET_KEY=changez-moi-en-production

# Mode debug — mettre False en production
DEBUG=True
